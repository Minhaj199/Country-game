{
  "expo": {
    "name": "Country Quest",
    "slug": "country-quest",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F7F9FC"
    },
    "android": {
      "package": "com.countryquest.game",
      "adaptiveIcon": {
        "backgroundColor": "#F7F9FC"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-audio",
      [
        "expo-notifications",
        {
          "androidMode": "default",
          "androidCollapsedTitle": "Country Quest"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fdc3f37c-238d-41a2-a43a-eefc30728952"
      }
    }
  }
}
